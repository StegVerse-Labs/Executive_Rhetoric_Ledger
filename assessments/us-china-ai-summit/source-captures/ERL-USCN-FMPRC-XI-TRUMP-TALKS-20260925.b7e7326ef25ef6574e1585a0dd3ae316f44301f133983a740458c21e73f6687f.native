<!-- 标题 -->
<div class="news_header">
	<div class="news_header_title">President Xi Jinping Holds Talks with U.S. President Donald J. Trump</div>
        
	<div class="news_header_bottom">
		<div class="news_header_time">
			<span>Updated: <span class="xltime">September 25, 2026 07:50</span></span>
			<img src="../../../static/img/news_content/3_buttom001.jpg" class="print_img" onclick="window.print();" alt="" />
		</div>
		<div class="news_header_lang">
		
		<span data-desc="中文"><a href="https://www.fmprc.gov.cn/zyxw/202609/t20260925_12031134.shtml" target="_blank"></a></span>
		
		<span data-desc="法文"><a href="https://www.fmprc.gov.cn/fra/wjdt/zyxw/202609/t20260925_12031247.html" target="_blank"></a></span>
		
		<span data-desc="西文"><a href="https://www.mfa.gov.cn/esp/zxxx/202609/t20260925_12031248.html" target="_blank"></a></span>
		
		<span data-desc="俄文"><a href="https://www.mfa.gov.cn/rus/zxxx/202609/t20260925_12031153.html" target="_blank"></a></span>
		
		</div>
	</div>
</div>
