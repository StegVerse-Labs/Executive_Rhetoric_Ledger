{
  "contract_type": "physical_economics_report_pertinence_matrix",
  "contract_version": "0.1",
  "status": "RESEARCH_MATRIX_ACTIVE_NOT_VALIDATED",
  "purpose": "Deterministically map public Physical Economics report claim classes to required and contextual attributes so report boundaries are evidence-derived rather than model-chosen.",
  "governing_rules": [
    "Required attributes determine admissibility and boundary selection.",
    "Contextual attributes may inform interpretation but cannot silently relax or replace required evidence.",
    "A required attribute that is unavailable or opaque must remain visible and may narrow, qualify, or fail-close the claim.",
    "Attribute mappings are versioned. A mapping change must generate a report-protocol delta.",
    "Claim classes may compose; composed claims inherit the union of required attributes unless an explicit narrower protocol is independently validated.",
    "No scalar composite is required for report generation."
  ],
  "claim_classes": {
