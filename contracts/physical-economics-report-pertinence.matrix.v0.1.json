  "boundary_resolution": {
    "required_attribute_history": "Each claim inherits the shortest necessary admissible history among required attributes for conclusions requiring all of them, while preserving longer attribute-specific context separately.",
    "current_period": "A claim cannot be COMPLETE if any material required attribute is PARTIAL_CURRENT_PERIOD, PENDING_RELEASE, UNAVAILABLE, OPAQUE, or NOT_COMPARABLE unless the claim protocol explicitly permits a qualified partial posture.",
    "methodology": "A required attribute methodology break narrows the comparable window unless a validated bridge exists.",
    "uncertainty": "Required source-native uncertainty must be retained; unknown covariance prevents fabrication of aggregate precision."
  },
  "next_validation": [
    "Create positive and negative claim-to-attribute fixtures.",
