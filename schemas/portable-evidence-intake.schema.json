{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse-labs.github.io/Executive_Rhetoric_Ledger/schemas/portable-evidence-intake.schema.json",
  "title": "Portable Evidence Intake Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_version",
    "packet_id",
    "producer_repository",
    "destination_repository",
    "received_at",
    "artifact",
    "manifest",
    "receipt",
    "merkle_batch",
    "inclusion_proof",
    "intake_decision"
  ],
  "properties": {
    "packet_version": {"const": "stegverse.portable-evidence-intake.v1"},
    "packet_id": {"type": "string", "minLength": 8},
    "producer_repository": {"const": "StegVerse-Labs/FREE-DOM"},
    "destination_repository": {"const": "StegVerse-Labs/Executive_Rhetoric_Ledger"},
    "received_at": {"type": "string", "format": "date-time"},
    "artifact": {"type": "object"},
    "manifest": {"type": "object"},
    "receipt": {"type": "object"},
    "merkle_batch": {"type": "object"},
    "inclusion_proof": {"type": "object"},
    "intake_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "authority_effect", "standing_effect", "reason_codes"],
      "properties": {
        "status": {"enum": ["validated", "rejected", "correction-required"]},
        "authority_effect": {"const": "none"},
        "standing_effect": {"const": "none-until-ledger-review"},
        "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "acknowledgment_id": {"type": ["string", "null"]}
      }
    }
  }
}
