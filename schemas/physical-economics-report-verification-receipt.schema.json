{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.example/schemas/physical-economics-report-verification-receipt.schema.json",
  "title": "Physical Economics Report Verification Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verification_receipt_id",
    "report_id",
    "report_request_hash",
    "evidence_snapshot_id",
    "evidence_snapshot_hash",
    "boundary_manifest_id",
    "boundary_manifest_hash",
    "pertinence_matrix_version",
    "contract_version",
    "renderer_version",
    "report_content_hash",
    "source_receipt_ids",
    "verification_state"
  ],
  "properties": {
    "verification_receipt_id": {"type": "string", "minLength": 1},
    "report_id": {"type": "string", "minLength": 1},
    "report_request_hash": {"type": "string", "minLength": 1},
    "evidence_snapshot_id": {"type": "string", "minLength": 1},
    "evidence_snapshot_hash": {"type": "string", "minLength": 1},
    "boundary_manifest_id": {"type": "string", "minLength": 1},
    "boundary_manifest_hash": {"type": "string", "minLength": 1},
    "pertinence_matrix_version": {"type": "string", "minLength": 1},
    "contract_version": {"type": "string", "minLength": 1},
    "renderer_version": {"type": "string", "minLength": 1},
    "report_content_hash": {"type": "string", "minLength": 1},
    "source_receipt_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "verification_state": {
      "enum": ["VERIFIABLE", "FAIL_CLOSED_HASH_MISMATCH", "FAIL_CLOSED_MISSING_RECEIPT", "FAIL_CLOSED_PROTOCOL_MISMATCH"]
    },
    "verification_notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
