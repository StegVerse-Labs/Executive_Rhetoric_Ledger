{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/economic-distribution-observation.schema.json",
  "title": "ERL Economic Distribution Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "unit_of_analysis",
    "period",
    "created_or_available_value",
    "channels",
    "ownership_distribution",
    "producer_margin",
    "evidence",
    "confidence",
    "activation_authorized"
  ],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "unit_of_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {
        "type": {"enum": ["enterprise", "sector", "region", "household_cohort", "economy"]},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"}
      }
    },
    "created_or_available_value": {"$ref": "#/$defs/valueObservation"},
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labor_cash_compensation": {"$ref": "#/$defs/valueObservation"},
        "labor_non_cash_benefits": {"$ref": "#/$defs/valueObservation"},
        "employee_equity_grants": {"$ref": "#/$defs/valueObservation"},
        "employee_equity_appreciation": {"$ref": "#/$defs/valueObservation"},
        "executive_founder_equity_appreciation": {"$ref": "#/$defs/valueObservation"},
        "external_shareholder_appreciation": {"$ref": "#/$defs/valueObservation"},
        "retirement_household_asset_appreciation": {"$ref": "#/$defs/valueObservation"},
        "consumer_price_or_quality_benefit": {"$ref": "#/$defs/valueObservation"},
        "government_tax_capture": {"$ref": "#/$defs/valueObservation"},
        "creditor_financing_capture": {"$ref": "#/$defs/valueObservation"},
        "retained_enterprise_surplus": {"$ref": "#/$defs/valueObservation"},
        "unmet_need_or_foregone_consumption": {"$ref": "#/$defs/valueObservation"},
        "unknown_unallocated": {"$ref": "#/$defs/valueObservation"}
      }
    },
    "ownership_distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["observed", "partial", "missing", "not_applicable"]},
        "employee_participation_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "participation_by_wage_band": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["band", "participation_rate"],
            "properties": {
              "band": {"type": "string"},
              "participation_rate": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        },
        "equity_grant_share_of_compensation": {"type": ["number", "null"]},
        "employee_share_of_equity_appreciation": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "executive_founder_share_of_equity_appreciation": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "external_shareholder_share_of_equity_appreciation": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "vested_value": {"$ref": "#/$defs/valueObservation"},
        "unvested_value": {"$ref": "#/$defs/valueObservation"},
        "realized_gains": {"$ref": "#/$defs/valueObservation"},
        "unrealized_gains": {"$ref": "#/$defs/valueObservation"},
        "ownership_concentration_before": {"type": ["number", "null"]},
        "ownership_concentration_after": {"type": ["number", "null"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "producer_margin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["observed", "partial", "missing", "not_applicable"]},
        "gross_margin": {"type": ["number", "null"]},
        "operating_margin": {"type": ["number", "null"]},
        "net_margin": {"type": ["number", "null"]},
        "distributable_surplus_proxy": {"$ref": "#/$defs/valueObservation"},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "substitution_quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "substitution_observed": {"type": "boolean"},
        "quality_change": {"enum": ["higher", "equivalent", "lower", "mixed", "unknown"]},
        "effective_price_change_known": {"type": "boolean"},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "debt_and_financing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "household_financing_cost": {"$ref": "#/$defs/valueObservation"},
        "enterprise_financing_cost": {"$ref": "#/$defs/valueObservation"},
        "creditor_capture_identified": {"type": "boolean"}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_type", "locator", "role"],
        "properties": {
          "source_id": {"type": "string"},
          "source_type": {"enum": ["primary", "official", "regulatory", "company_filing", "statistical", "academic", "secondary", "proposal", "other"]},
          "locator": {"type": "string"},
          "role": {"enum": ["supports_input", "supports_method", "policy_seed", "control", "counterexample", "context"]},
          "notes": {"type": "string"}
        }
      }
    },
    "confidence": {"enum": ["high", "moderate", "low", "insufficient"]},
    "missing_evidence": {"type": "array", "items": {"type": "string"}},
    "policy_seed": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "proponent": {"type": "string"},
        "mechanism": {"type": "string"},
        "causal_effect_established": {"const": false}
      }
    },
    "activation_authorized": {"const": false}
  },
  "$defs": {
    "valueObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["observed", "estimated", "partial", "missing", "not_applicable"]},
        "amount": {"type": ["number", "null"]},
        "currency": {"type": ["string", "null"]},
        "real_or_nominal": {"enum": ["real", "nominal", "ratio", "index", "unknown"]},
        "source_id": {"type": ["string", "null"]},
        "confidence": {"enum": ["high", "moderate", "low", "insufficient"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
