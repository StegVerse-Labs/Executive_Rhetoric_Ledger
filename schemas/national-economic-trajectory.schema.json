{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StegVerse-Labs/Executive_Rhetoric_Ledger/schemas/national-economic-trajectory.schema.json",
  "title": "National Economic Trajectory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lane_id",
    "jurisdiction",
    "evidence_period",
    "status",
    "measurement_dictionary",
    "observations",
    "findings",
    "gaps",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": "stegverse.erl.national-economic-trajectory.v1"
    },
    "lane_id": {
      "enum": [
        "ERL-ECON-CA",
        "ERL-ECON-US"
      ]
    },
    "jurisdiction": {
      "enum": [
        "Canada",
        "United States"
      ]
    },
    "evidence_period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "baseline_policy"
      ],
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "baseline_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "enum": [
        "framework",
        "evidence-population",
        "review",
        "active",
        "superseded"
      ]
    },
    "measurement_dictionary": {
      "const": "economic-trajectories/measurement-dictionary.v1.json"
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_authority",
        "may_publish",
        "may_infer_missing_effects",
        "reviewed_findings_may_be_compared"
      ],
      "properties": {
        "research_authority": {
          "const": "ERL"
        },
        "may_publish": {
          "const": false
        },
        "may_infer_missing_effects": {
          "const": false
        },
        "reviewed_findings_may_be_compared": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "publisher",
        "title",
        "url",
        "source_class",
        "release_date",
        "accessed_date",
        "supports",
        "limitations"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "source_class": {
          "enum": [
            "official-government",
            "legislative",
            "central-bank",
            "international-organization",
            "academic",
            "independent-analysis",
            "media",
            "advocacy",
            "other"
          ]
        },
        "release_date": {
          "type": "string"
        },
        "accessed_date": {
          "type": "string"
        },
        "supports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "indicator_id",
        "period_start",
        "period_end",
        "reported_value",
        "unit",
        "price_basis",
        "denominator",
        "geography",
        "population_scope",
        "revision_status",
        "sources",
        "effect_status"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^ERL-ECON-(CA|US)-OBS-[A-Z0-9-]+$"
        },
        "indicator_id": {
          "type": "string",
          "pattern": "^ECON-[A-Z0-9-]+$"
        },
        "period_start": {
          "type": "string"
        },
        "period_end": {
          "type": "string"
        },
        "reported_value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "price_basis": {
          "enum": [
            "nominal",
            "real",
            "PPP",
            "chained",
            "index",
            "not-applicable",
            "unspecified-source-language"
          ]
        },
        "denominator": {
          "enum": [
            "total",
            "per-capita",
            "per-household",
            "median-household",
            "per-worker",
            "per-hour",
            "percentile-share",
            "sector",
            "none",
            "other"
          ]
        },
        "geography": {
          "type": "string",
          "minLength": 1
        },
        "population_scope": {
          "type": "string",
          "minLength": 1
        },
        "revision_status": {
          "enum": [
            "initial",
            "revised",
            "provisional",
            "historical-series",
            "source-language"
          ]
        },
        "seasonal_adjustment": {
          "enum": [
            "adjusted",
            "unadjusted",
            "not-applicable",
            "unspecified"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "effect_status": {
          "const": "NOT_INFERRED_FROM_OBSERVATION"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "status",
        "observation_ids",
        "mechanism",
        "effects",
        "controls",
        "contrary_evidence",
        "confidence",
        "review"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^ERL-ECON-(CA|US)-FIND-[A-Z0-9-]+$"
        },
        "status": {
          "enum": [
            "candidate",
            "reviewed",
            "rejected",
            "superseded"
          ]
        },
        "observation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "mechanism": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "evidence_source_ids",
            "alternatives"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "evidence_source_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "alternatives": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "population",
              "direction",
              "evidence_source_ids"
            ],
            "properties": {
              "population": {
                "type": "string",
                "minLength": 1
              },
              "direction": {
                "enum": [
                  "increase",
                  "decrease",
                  "mixed",
                  "no-detectable-change",
                  "unresolved"
                ]
              },
              "magnitude": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "unit": {
                "type": "string"
              },
              "evidence_source_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "contrary_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewer",
            "reviewed_at",
            "independent",
            "reproducible"
          ],
          "properties": {
            "reviewer": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "independent": {
              "type": "boolean"
            },
            "reproducible": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap_id",
        "dimension",
        "missing_evidence",
        "target_source_classes",
        "next_query",
        "status"
      ],
      "properties": {
        "gap_id": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "type": "string",
          "minLength": 1
        },
        "missing_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "target_source_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "next_query": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "open",
            "searching",
            "partially-filled",
            "resolved",
            "superseded"
          ]
        }
      }
    }
  }
}
