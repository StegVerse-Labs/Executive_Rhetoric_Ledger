{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StegVerse-Labs/Executive_Rhetoric_Ledger/schemas/historical-backfill-queue.schema.json",
  "title": "Historical Backfill Queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["queue_id", "generated_at", "status", "tasks", "authority_boundary"],
  "properties": {
    "queue_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["planned", "running", "completed", "blocked", "superseded"]},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "priority", "reason", "query", "source_classes", "status", "review_required"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "priority": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
          "reason": {"type": "string", "enum": ["graph-gap", "missing-control", "temporal-gap", "source-diversity-gap", "outcome-gap"]},
          "query": {"type": "string", "minLength": 1},
          "source_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "related_node_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "status": {"type": "string", "enum": ["planned", "executed", "failed", "superseded"]},
          "review_required": {"type": "boolean", "const": true}
        }
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automation_may_queue", "automation_may_close_evidentiary_gap"],
      "properties": {
        "automation_may_queue": {"type": "boolean", "const": true},
        "automation_may_close_evidentiary_gap": {"type": "boolean", "const": false}
      }
    }
  }
}
