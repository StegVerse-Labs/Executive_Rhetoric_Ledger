{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StegVerse-Labs/Executive_Rhetoric_Ledger/schemas/source-family.schema.json",
  "title": "Executive Rhetoric Ledger Source Family",
  "type": "object",
  "additionalProperties": false,
  "required": ["family_id", "enabled", "index_type", "index_url", "source_class", "allowed_hosts", "allowed_path_prefixes", "relevance_terms", "max_links", "review_boundary"],
  "properties": {
    "family_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]+$"},
    "enabled": {"type": "boolean"},
    "index_type": {"enum": ["html-index", "local-html-index"]},
    "index_url": {"type": "string", "minLength": 1},
    "link_base_url": {"type": "string", "pattern": "^https?://"},
    "source_class": {"type": "string", "enum": ["primary-legal-record", "official-government", "court-record", "legislative-oversight", "local-reporting", "national-reporting", "advocacy-record", "historical-archive"]},
    "allowed_hosts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "allowed_path_prefixes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^/"}},
    "relevance_terms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
    "max_links": {"type": "integer", "minimum": 1, "maximum": 100},
    "request_headers": {"type": "object", "additionalProperties": {"type": "string"}},
    "review_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automation_may_discover", "automation_may_capture", "automation_may_promote"],
      "properties": {
        "automation_may_discover": {"const": true},
        "automation_may_capture": {"const": true},
        "automation_may_promote": {"const": false}
      }
    }
  }
}
