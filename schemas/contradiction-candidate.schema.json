{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StegVerse-Labs/Executive_Rhetoric_Ledger/schemas/contradiction-candidate.schema.json",
  "title": "Contradiction or Correction Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "generated_at", "posture", "earlier_record", "later_record", "comparison_basis", "temporal_order", "status", "authority_boundary"],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "posture": {"type": "string", "enum": ["possible-contradiction", "possible-correction", "possible-supersession", "unresolved-variance"]},
    "earlier_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "observed_at", "source_posture", "statement_hash"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "minLength": 1},
        "source_posture": {"type": "string", "minLength": 1},
        "statement_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "later_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "observed_at", "source_posture", "statement_hash"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "minLength": 1},
        "source_posture": {"type": "string", "minLength": 1},
        "statement_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "comparison_basis": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["same-topic", "same-actor", "same-agency", "same-policy-reference", "explicit-correction-language", "supersession-reference", "outcome-variance"]}},
    "temporal_order": {"type": "string", "const": "earlier-before-later"},
    "status": {"type": "string", "enum": ["candidate-generated", "review-required", "reviewed-confirmed", "reviewed-rejected", "superseded"]},
    "supersedes_candidate_id": {"type": "string"},
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automation_may_flag_variance", "automation_may_declare_falsehood", "automation_may_resolve_contradiction"],
      "properties": {
        "automation_may_flag_variance": {"type": "boolean", "const": true},
        "automation_may_declare_falsehood": {"type": "boolean", "const": false},
        "automation_may_resolve_contradiction": {"type": "boolean", "const": false}
      }
    }
  }
}
