{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/erl/schemas/market-source-timeseries.schema.json",
  "title": "ERL Market Source Timeseries",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "series_id",
    "source_family",
    "provider",
    "retrieved_at_utc",
    "granularity",
    "metrics",
    "observations",
    "source_refs",
    "research_authority",
    "execution_authority",
    "may_authorize_order"
  ],
  "properties": {
    "schema": {"const": "stegverse.erl.market_source_timeseries.v1"},
    "series_id": {"type": "string", "minLength": 1},
    "source_family": {
      "enum": [
        "spot_market",
        "derivatives",
        "order_book_liquidity",
        "stablecoin_flows",
        "etf_fund_flows",
        "on_chain_flows",
        "macro_cross_market"
      ]
    },
    "provider": {"type": "string", "minLength": 1},
    "retrieved_at_utc": {"type": "string", "format": "date-time"},
    "granularity": {"type": "string", "minLength": 1},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["as_of_utc", "values"],
        "properties": {
          "as_of_utc": {"type": "string", "format": "date-time"},
          "instrument": {"type": ["string", "null"]},
          "venue": {"type": ["string", "null"]},
          "values": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": ["number", "null"]}
          },
          "quality_flags": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "notes": {"type": "array", "items": {"type": "string"}},
    "research_authority": {"const": "ERL"},
    "execution_authority": {"const": "NONE"},
    "may_authorize_order": {"const": false}
  }
}
