{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/reclamation-kv-provider-operation-receipt.schema.json",
  "title": "Reclamation KnowledgeVault Provider Operation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "target_set_id",
    "subject_ref",
    "kv_lane",
    "provider",
    "provider_resource_id",
    "provider_parent_id",
    "provider_mime_type",
    "provider_title",
    "sha256",
    "size_bytes",
    "exact_provider_readback",
    "proof_class",
    "native_writer_executed",
    "provider_deletion_success",
    "observed_at"
  ],
  "properties": {
    "schema": {"const": "stegverse.reclamation.kv-provider-operation-receipt/v1"},
    "task_id": {"const": "SS-DATA-RECLAMATION-KV-CUSTODY-001"},
    "target_set_id": {"type": "string", "minLength": 1},
    "subject_ref": {"type": "string", "minLength": 1},
    "kv_lane": {"const": "02_Research/Data_Reclamation/Subjects"},
    "subject_key": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "target_set_key": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "provider": {"const": "GOOGLE_DRIVE"},
    "provider_root_id": {"type": "string", "minLength": 1},
    "provider_research_folder_id": {"type": "string", "minLength": 1},
    "provider_reclamation_folder_id": {"type": "string", "minLength": 1},
    "provider_subjects_folder_id": {"type": "string", "minLength": 1},
    "provider_subject_folder_id": {"type": "string", "minLength": 1},
    "provider_target_folder_id": {"type": "string", "minLength": 1},
    "provider_resource_id": {"type": "string", "minLength": 1},
    "provider_parent_id": {"type": "string", "minLength": 1},
    "provider_mime_type": {"const": "text/plain"},
    "provider_title": {"const": "target-set.json"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "exact_provider_readback": {"const": true},
    "proof_class": {"const": "PROVIDER_OPERATION_EXACT_READBACK"},
    "native_writer_executed": {"const": false},
    "provider_deletion_success": {"const": false},
    "credential_material_present": {"const": false},
    "observed_at": {"type": "string", "format": "date-time"},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
