{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StegVerse-Labs/Executive_Rhetoric_Ledger/schemas/force-event-packet.schema.json",
  "title": "Individualized Force Event Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "topic_id",
    "event_status",
    "event_type",
    "approximate_time",
    "subject_posture",
    "government_action",
    "claimed_justification",
    "direct_observations",
    "missing_evidence",
    "source_receipt_ids",
    "authority_transition_ids",
    "classification"
  ],
  "properties": {
    "event_id": {"type": "string", "pattern": "^DH-FORCE-[0-9]{3}$"},
    "topic_id": {"type": "string", "minLength": 1},
    "event_status": {"type": "string", "enum": ["catalogued", "under-review", "accepted-with-limitations", "disputed", "superseded"]},
    "event_type": {"type": "string", "enum": ["physical-restraint", "chemical-agent", "baton-display", "baton-strike", "arrest", "observer-contact", "crowd-movement", "other"]},
    "approximate_time": {"type": "string", "minLength": 1},
    "subject_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_status", "role_status", "visible_conduct"],
      "properties": {
        "identity_status": {"type": "string", "enum": ["unknown", "partially-identified", "identified"]},
        "role_status": {"type": "string", "enum": ["unknown", "protester", "observer", "journalist", "elected-official", "officer", "detainee-family", "other"]},
        "visible_conduct": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "government_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_identity_status", "agency_status", "action_description", "force_tools"],
      "properties": {
        "actor_identity_status": {"type": "string", "enum": ["unknown", "partially-identified", "identified"]},
        "agency_status": {"type": "string", "enum": ["unknown", "visible-marking-only", "confirmed"]},
        "action_description": {"type": "string", "minLength": 1},
        "force_tools": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "claimed_justification": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "direct_observations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "prohibited_inferences": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "missing_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_receipt_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "intake_ids": {"type": "array", "items": {"type": "string", "pattern": "^DH-INTAKE-[0-9]{3}$"}},
    "authority_transition_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^T([1-9]|1[0-2])$"}},
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["necessity", "proportionality", "lawfulness", "confidence"],
      "properties": {
        "necessity": {"type": "string", "enum": ["not-established", "supported", "not-supported", "disputed"]},
        "proportionality": {"type": "string", "enum": ["not-established", "supported", "not-supported", "disputed"]},
        "lawfulness": {"type": "string", "enum": ["not-established", "supported", "not-supported", "disputed"]},
        "confidence": {"type": "string", "enum": ["high", "medium", "low", "unknown"]},
        "notes": {"type": "string"}
      }
    }
  }
}
