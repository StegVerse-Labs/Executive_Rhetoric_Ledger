{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "activation-state.schema.json",
  "title": "Executive Rhetoric Ledger Activation State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "repo_status",
    "activation_percent",
    "activation_issue",
    "current_pending_receipt",
    "activation_runbook",
    "final_handoff",
    "required_before_activated"
  ],
  "properties": {
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "repo_status": {
      "type": "string",
      "enum": [
        "activation-ready-pending-validation",
        "activated",
        "blocked",
        "superseded"
      ]
    },
    "activation_percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "activation_issue": {
      "type": "integer",
      "minimum": 1
    },
    "current_pending_receipt": {
      "type": "string",
      "minLength": 1
    },
    "activation_runbook": {
      "type": "string",
      "minLength": 1
    },
    "final_handoff": {
      "type": "string",
      "minLength": 1
    },
    "required_before_activated": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
