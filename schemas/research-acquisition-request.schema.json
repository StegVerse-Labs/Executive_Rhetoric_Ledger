{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/erl/research-acquisition-request.v1.json",
  "title": "ERL Research Acquisition Request",
  "type": "object",
  "required": ["request_id", "trajectory_ids", "query", "state"],
  "properties": {
    "request_id": {"type": "string", "minLength": 3},
    "trajectory_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
    "query": {"type": "string", "minLength": 2},
    "state": {"enum": ["OPEN", "ACTIVE", "RETRY", "COMPLETE", "BLOCKED", "FAILED", "SUPERSEDED", "MERGED"]},
    "source_classes": {"type": "array", "items": {"type": "string"}},
    "priority": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
    "created_at": {"type": "string"},
    "originating_goal": {"type": "string"},
    "collision_key": {"type": "string"},
    "release_condition": {"type": "string"}
  },
  "additionalProperties": true
}
