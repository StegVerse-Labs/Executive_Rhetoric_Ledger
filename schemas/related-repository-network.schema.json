{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StegVerse-Labs/Executive_Rhetoric_Ledger/schemas/related-repository-network.schema.json",
  "title": "Executive Rhetoric Ledger Related Repository Network",
  "type": "object",
  "additionalProperties": false,
  "required": ["network_id", "ledger_repository", "status", "last_reviewed", "repositories", "governance_rules"],
  "properties": {
    "network_id": {"type": "string", "minLength": 1},
    "ledger_repository": {"const": "StegVerse-Labs/Executive_Rhetoric_Ledger"},
    "status": {"enum": ["draft", "active", "paused", "superseded"]},
    "last_reviewed": {"type": "string", "minLength": 1},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "relationship_status", "roles", "allowed_contributions", "evidence_boundary", "ingestion_direction"],
        "properties": {
          "repository": {"type": "string", "pattern": "^StegVerse-Labs/[A-Za-z0-9_.-]+$"},
          "relationship_status": {"enum": ["declared", "adapter-planned", "adapter-active", "paused", "deprecated"]},
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "oversight-source",
                "scholarly-research",
                "social-signal-discovery",
                "patent-and-innovation-history",
                "administration-record",
                "person-or-network-specific-record",
                "public-figure-record",
                "genealogical-and-family-history",
                "educational-surface",
                "biographical-surface",
                "historical-backfill",
                "adjacency-discovery",
                "control-comparison",
                "outcome-refresh"
              ]
            }
          },
          "allowed_contributions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "candidate-incidents",
                "source-receipts",
                "primary-record-pointers",
                "historical-context",
                "biographical-context",
                "relationship-claims",
                "rhetoric-records",
                "action-records",
                "institutional-response-records",
                "outcome-records",
                "control-candidates",
                "contradiction-candidates",
                "adjacency-links",
                "educational-summaries"
              ]
            }
          },
          "evidence_boundary": {"type": "string", "minLength": 1},
          "ingestion_direction": {"enum": ["upstream-to-ledger", "bidirectional-reviewed", "ledger-to-publication-surface"]},
          "notes": {"type": "string"}
        }
      }
    },
    "governance_rules": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
