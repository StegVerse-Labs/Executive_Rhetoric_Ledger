{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/erl/research-source-candidate.v1.json",
  "title": "ERL Research Source Candidate",
  "type": "object",
  "required": ["candidate_id", "repository", "trajectory_ids", "acquisition_request_id", "source_url", "retrieved_at", "verification_state", "evidence_role", "discovered_by"],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 3},
    "repository": {"type": "string", "minLength": 2},
    "trajectory_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "acquisition_request_id": {"type": "string"},
    "query": {"type": "string"},
    "source_url": {"type": "string", "minLength": 4},
    "source_title": {"type": "string"},
    "retrieved_at": {"type": "string"},
    "source_class": {"type": "string"},
    "institutional_proximity": {"type": "string"},
    "content_hash": {"type": ["string", "null"]},
    "custody_pointer": {"type": ["string", "null"]},
    "verification_state": {"enum": ["unverified", "partially-verified", "verified-secondary", "verified-primary"]},
    "evidence_role": {"enum": ["lead-only", "context-only"]},
    "discovered_by": {"type": "string"},
    "native_records_mutated": {"type": "boolean"},
    "evaluation_changed": {"type": "boolean"},
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
