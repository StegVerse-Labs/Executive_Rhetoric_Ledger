{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StegVerse-Labs/Executive_Rhetoric_Ledger/schemas/primary-record-intake.schema.json",
  "title": "Primary Record Intake Queue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "queue_id",
    "topic_id",
    "queue_status",
    "created_date",
    "last_reviewed",
    "items"
  ],
  "properties": {
    "queue_id": {"type": "string", "minLength": 1},
    "topic_id": {"type": "string", "minLength": 1},
    "queue_status": {
      "type": "string",
      "enum": ["draft", "active", "paused", "complete", "superseded"]
    },
    "created_date": {"type": "string", "minLength": 1},
    "last_reviewed": {"type": "string", "minLength": 1},
    "notes": {"type": "string"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "intake_id",
          "record_class",
          "likely_custodians",
          "affected_branches",
          "state",
          "activation_effect",
          "privacy_posture",
          "priority"
        ],
        "properties": {
          "intake_id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_-]*-INTAKE-[0-9]{3}$"
          },
          "record_class": {"type": "string", "minLength": 1},
          "likely_custodians": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "affected_branches": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "state": {
            "type": "string",
            "enum": [
              "requested",
              "located",
              "received-unverified",
              "verified-primary",
              "verified-secondary",
              "conflicting-records",
              "restricted-or-sealed",
              "unavailable",
              "superseded"
            ]
          },
          "activation_effect": {"type": "string", "minLength": 1},
          "privacy_posture": {
            "type": "string",
            "enum": ["public", "privacy-sensitive", "restricted-or-sealed", "unknown"]
          },
          "priority": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "source_receipt_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "notes": {"type": "string"}
        }
      }
    }
  }
}
