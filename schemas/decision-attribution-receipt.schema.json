{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse-labs.github.io/Executive_Rhetoric_Ledger/schemas/decision-attribution-receipt.schema.json",
  "title": "Decision Attribution Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "receipt_version",
    "subject_context_id",
    "decision_time",
    "decision_requested",
    "decision_actor",
    "authority_chain",
    "evidence_available",
    "decision_result",
    "decision_reason",
    "responsibility_chain",
    "disclosure_posture",
    "verification_status",
    "promotion_state"
  ],
  "properties": {
    "receipt_id": {"type": "string", "minLength": 1},
    "receipt_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "subject_context_id": {"type": "string", "minLength": 1},
    "linked_rhetoric_record_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "decision_time": {"type": ["string", "null"], "format": "date-time"},
    "decision_time_status": {"type": "string", "enum": ["exact", "estimated", "period-only", "unknown"]},
    "decision_requested": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "target", "scope", "requested_by"],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "target": {"type": ["string", "null"]},
        "scope": {"type": "string", "minLength": 1},
        "requested_by": {"type": "string", "minLength": 1},
        "request_source_record": {"type": ["string", "null"]}
      }
    },
    "decision_actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_type", "office_or_component"],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1},
        "actor_type": {"type": "string", "enum": ["human", "non-governed-ai", "governed-ai", "mixed", "unknown"]},
        "office_or_component": {"type": "string", "minLength": 1},
        "individual_identity_status": {"type": "string", "enum": ["identified", "role-only", "unknown"]}
      }
    },
    "authority_chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "authority_source", "authority_type", "authority_status"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "authority_source": {"type": "string", "minLength": 1},
          "authority_type": {"type": "string", "enum": ["statute", "court-order", "executive-order", "presidential-directive", "department-directive", "component-directive", "supervisory-order", "policy", "quota", "practice", "override", "unknown"]},
          "authority_status": {"type": "string", "enum": ["verified", "reported", "disputed", "missing", "unknown"]},
          "record_reference": {"type": ["string", "null"]}
        }
      }
    },
    "evidence_available": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "evidence_type", "evidence_status", "relevance"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "evidence_type": {"type": "string", "minLength": 1},
          "evidence_status": {"type": "string", "enum": ["verified", "reported", "disputed", "withheld", "missing", "unknown"]},
          "relevance": {"type": "string", "minLength": 1},
          "source_reference": {"type": ["string", "null"]}
        }
      }
    },
    "conflicts_or_objections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["raised_by", "conflict", "disposition"],
        "properties": {
          "raised_by": {"type": "string", "minLength": 1},
          "conflict": {"type": "string", "minLength": 1},
          "disposition": {"type": "string", "enum": ["accepted", "rejected", "ignored", "overridden", "unresolved", "unknown"]},
          "record_reference": {"type": ["string", "null"]}
        }
      }
    },
    "decision_result": {"type": "string", "enum": ["execute", "refuse", "modify", "delay", "escalate", "unknown"]},
    "decision_reason": {"type": "string", "minLength": 1},
    "override": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["occurred", "override_authority", "override_reason", "record_reference"],
      "properties": {
        "occurred": {"type": "boolean"},
        "override_authority": {"type": ["string", "null"]},
        "override_reason": {"type": ["string", "null"]},
        "record_reference": {"type": ["string", "null"]}
      }
    },
    "resulting_action": {"type": ["string", "null"]},
    "known_consequence": {"type": ["string", "null"]},
    "responsibility_chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "responsible_actor_or_office", "responsibility_type", "basis"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "responsible_actor_or_office": {"type": "string", "minLength": 1},
          "responsibility_type": {"type": "string", "enum": ["originated", "directed", "implemented", "approved", "overrode", "ratified", "failed-to-correct", "accepted-consequence", "unknown"]},
          "basis": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["verified", "reported", "inferred", "disputed", "unknown"]}
        }
      }
    },
    "disclosure_posture": {"type": "string", "enum": ["fully-disclosed", "partially-disclosed", "not-disclosed-before-action", "discovered-after-action", "disputed", "unknown"]},
    "verification_status": {"type": "string", "enum": ["fixture", "reported", "primary-record-supported", "multi-source-supported", "disputed", "incomplete"]},
    "promotion_state": {"type": "string", "enum": ["fixture-only", "register-only", "review-ready", "promoted", "superseded"]},
    "final_legal_finding": {"type": ["string", "null"]}
  }
}
