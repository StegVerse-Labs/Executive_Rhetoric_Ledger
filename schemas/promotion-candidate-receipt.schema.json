{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StegVerse-Labs/Executive_Rhetoric_Ledger/schemas/promotion-candidate-receipt.schema.json",
  "title": "Promotion Candidate Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_id", "subject_id", "proposed_class", "review_assignment_ref", "evidence_refs", "decision_state", "promotion_state", "automation_authority"],
  "properties": {
    "receipt_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "proposed_class": {"type": "string", "enum": ["action_record", "rhetoric_record", "contradiction_record", "correction_record", "outcome_update", "hold"]},
    "review_assignment_ref": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "decision_state": {"type": "string", "enum": ["awaiting-review", "approved", "rejected", "deferred", "superseded"]},
    "decision_receipt_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "promotion_state": {"type": "string", "enum": ["not-authorized", "ready-after-quorum", "promoted", "rejected", "superseded"]},
    "promoted_receipt_ref": {"type": "string"},
    "automation_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may_prepare", "may_record_decision", "may_promote"],
      "properties": {
        "may_prepare": {"const": true},
        "may_record_decision": {"const": false},
        "may_promote": {"const": false}
      }
    }
  }
}
