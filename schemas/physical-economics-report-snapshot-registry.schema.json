{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.example/schemas/physical-economics-report-snapshot-registry.schema.json",
  "title": "Physical Economics Report Snapshot Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "entries"],
  "properties": {
    "registry_version": {"const": "physical-economics-report-snapshot-registry.v0.1"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "registry_entry_id",
          "state",
          "scope",
          "claim_classes",
          "pertinence_matrix_version",
          "allowed_vintage_policies",
          "snapshot_template_path",
          "admitted_at"
        ],
        "properties": {
          "registry_entry_id": {"type": "string", "minLength": 1},
          "state": {"enum": ["ADMITTED", "SUSPENDED", "RETIRED"]},
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subject", "economic_domain", "geography", "population_scope"],
            "properties": {
              "subject": {"type": "string", "minLength": 1},
              "economic_domain": {"type": "string", "minLength": 1},
              "geography": {"type": "string", "minLength": 1},
              "population_scope": {"type": "string", "minLength": 1},
              "essential_or_discretionary_class": {
                "enum": ["ESSENTIAL", "DISCRETIONARY", "MIXED", "UNRESOLVED"]
              },
              "unit_definition": {"type": ["string", "null"]}
            }
          },
          "claim_classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "pertinence_matrix_version": {"type": "string", "minLength": 1},
          "allowed_vintage_policies": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "CURRENT_VINTAGE",
                "AS_KNOWN_AT_REQUESTED_TIME",
                "BOTH_CURRENT_AND_HISTORICAL_VINTAGE"
              ]
            }
          },
          "snapshot_template_path": {"type": "string", "minLength": 1},
          "admitted_at": {"type": "string", "format": "date-time"},
          "notes": {"type": ["string", "null"]}
        }
      }
    }
  }
}
